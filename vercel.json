{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.3"
    },
    "index.php": {
      "runtime": "vercel-php@0.7.3"
    }
  },
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/redirect.php",
      "dest": "/api/redirect.php"
    },
    {
      "src": "/generate.php",
      "dest": "/api/generate.php"
    },
    {
      "src": "/",
      "dest": "/index.php"
    },
    {
      "src": "/([a-zA-Z0-9_-]+)/?",
      "dest": "/api/redirect.php?slug=$1"
    }
  ]
}
