{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.6.0"
    }
  },
  "routes": [
    {
      "src": "/redirect.php",
      "dest": "/api/redirect.php"
    },
    {
      "src": "/generate.php",
      "dest": "/api/generate.php"
    },
    {
      "src": "/(.*)",
      "dest": "/api/$1"
    }
  ]
}
