RewriteEngine On
RewriteBase /

# 1. Biarkan file & folder asli diakses langsung
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 2. Arahkan slug (URL pendek) ke redirect.php
RewriteRule ^([a-zA-Z0-9_-]+)/?$ redirect.php?slug=$1 [L,QSA]link-engine-backend
